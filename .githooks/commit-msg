#!/bin/sh
# Lokale Sperre vor jedem Commit: bricht ab, wenn die Nachricht eine
# Co-Authored-By- oder Tool-Trailer-Zeile, einen Bot-/Werkzeugnamen oder das
# Roboter-Emoji enthält oder git user.name/user.email nicht der erlaubten
# Person entspricht. Die Regeln stehen nur in author_guard.py.
set -eu
root=$(git rev-parse --show-toplevel)
exec python3 "$root/Obsidian/_tools/author_guard.py" --message-file "$1" --config
