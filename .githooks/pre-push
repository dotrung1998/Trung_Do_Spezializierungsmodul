#!/bin/sh
# Lokale Sperre: prüft alle Commits, die gerade gepusht werden sollen.
set -eu
root=$(git rev-parse --show-toplevel)
guard="$root/Obsidian/_tools/author_guard.py"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$remote_sha" in
    0000000000000000000000000000000000000000)
      python3 "$guard" --commit "$local_sha" || status=1
      ;;
    *)
      python3 "$guard" --range "$remote_sha..$local_sha" || status=1
      ;;
  esac
done
exit "$status"
